<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Event Image -->
        <ImageView
            android:id="@+id/imgEvent"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:scaleType="centerCrop"
            android:src="@drawable/fashionimage" />

        <!-- Event Title -->
        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fashion Expo 2026"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:textColor="#000" />

        <!-- Location + Date -->
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mumbai · 22 Dec"
            android:textColor="#777"
            android:layout_marginStart="16dp" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹499"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp" />

        <!-- About this Event Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="About this Event"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000" />

                <TextView
                    android:text="Tap to read full details about this event"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:textSize="13sp"
                    android:textColor="#777"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Info Row -->
        <TextView
            android:text="⏱ 3 Hours   |   🎭 Fashion   |   👤 Style Inc."
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            android:textColor="#555"
            android:textSize="13sp" />

        <!-- Proceed Button -->
        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Proceed to Pay"
            android:textAllCaps="false"
            android:layout_margin="16dp"
            android:backgroundTint="#C8B6A6"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
