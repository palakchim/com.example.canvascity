<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE8">

    <!-- AI Header -->
    <LinearLayout
        android:id="@+id/aiHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Stylist"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvAiSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart outfit suggestions for every event"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- AI Illustration -->
    <ImageView
        android:id="@+id/imgAi"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/ai2"
        android:contentDescription="AI Illustration"
        app:layout_constraintTop_toBottomOf="@id/aiHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Input Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAiInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/imgAi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe your event"
                android:textColor="#000000"
                android:textStyle="bold" />

            <!-- ✅ CLEAN DROPDOWN SUGGESTIONS -->
            <ListView
                android:id="@+id/listSuggestions"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:dividerHeight="1dp"
                android:scrollbars="vertical"
                android:elevation="8dp" />

            <!-- Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etEvent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Wedding, Party, Office, Body type..."
                    android:backgroundTint="#000000"
                    android:textColor="#000000"
                    android:padding="10dp" />

                <ImageView
                    android:id="@+id/imgGallery"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/gallery2"
                    android:contentDescription="Open Gallery" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAiSuggest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Get AI Suggestion"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:backgroundTint="@color/sky_blue"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- AI Response -->
    <TextView
        android:id="@+id/tvAiResponse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="✨ AI suggestions will appear here"
        android:textColor="#000000"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardAiInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
